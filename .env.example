# One OpenAI-compatible provider. The service proxies the client's key to it.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_MODEL=gpt-4.1-mini
# Optional fallback when a request carries no Authorization header.
# UPSTREAM_API_KEY=sk-...

# UNCOMMENT for providers that reject response_format=json_schema.
# UPSTREAM_STRUCTURED_OUTPUT=json_object

# OCR pipeline tuning.
OCR_MODEL_NAME=mistral-ocr-latest
OCR_DPI=200
OCR_IMAGE_FORMAT=jpeg
OCR_IMAGE_QUALITY=85
OCR_MAX_PAGES=100
OCR_MAX_DOCUMENT_MB=30
OCR_PAGE_CONCURRENCY=4
OCR_MAX_TOKENS=8192
OCR_TEMPERATURE=0
